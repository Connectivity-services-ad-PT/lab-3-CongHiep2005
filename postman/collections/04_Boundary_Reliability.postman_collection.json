{
  "info": {
    "_postman_id": "fit4110-lab03-iot-ingestion-04-boundary",
    "name": "FIT4110 Lab03 - 04_Boundary_Reliability",
    "description": "Boundary and reliability tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST /readings - boundary value 80 is accepted",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{authToken}}" } ],
        "url": { "raw": "{{baseUrl}}/readings", "protocol": "{{protocol}}", "host": ["{{host}}"], "port": "{{port}}", "path": ["readings"] },
        "body": { "mode": "raw", "raw": "{\n  \"device_id\": \"ESP32-LAB-A01\",\n  \"metric\": \"temperature\",\n  \"value\": 80,\n  \"unit\": \"celsius\",\n  \"timestamp\": \"2026-05-13T08:30:00+07:00\"\n}", "options": { "raw": { "language": "json" } } }
      },
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Boundary value at max returns success', function () { pm.expect(pm.response.code).to.eql(201); });",
        "pm.test('Response confirms accepted reading', function () { const json = pm.response.json(); pm.expect(json).to.have.property('accepted', true); });"
      ] } } ]
    },
    {
      "name": "POST /readings - value 81 is rejected as out of range",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{authToken}}" }, { "key": "Prefer", "value": "code=400" } ],
        "url": { "raw": "{{baseUrl}}/readings", "protocol": "{{protocol}}", "host": ["{{host}}"], "port": "{{port}}", "path": ["readings"] },
        "body": { "mode": "raw", "raw": "{\n  \"device_id\": \"ESP32-LAB-A01\",\n  \"metric\": \"temperature\",\n  \"value\": 81,\n  \"unit\": \"celsius\",\n  \"timestamp\": \"2026-05-13T08:30:00+07:00\"\n}", "options": { "raw": { "language": "json" } } }
      },
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Out-of-range value returns client error', function () { pm.expect([400, 422]).to.include(pm.response.code); });",
        "pm.test('Boundary test checks response, not request body', function () { const json = pm.response.json(); pm.expect(json).to.have.property('status'); pm.expect(json.status).to.be.within(400, 599); });"
      ] } } ]
    },
    {
      "name": "GET /readings/latest - limit above max is rejected",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{authToken}}" }, { "key": "Prefer", "value": "code=400" } ],
        "url": { "raw": "{{baseUrl}}/readings/latest?limit=101", "protocol": "{{protocol}}", "host": ["{{host}}"], "port": "{{port}}", "path": ["readings","latest"], "query": [ { "key": "limit", "value": "101" } ] }
      },
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Limit above max returns client error', function () { pm.expect([400, 422]).to.include(pm.response.code); });"
      ] } } ]
    }
  ]
}
