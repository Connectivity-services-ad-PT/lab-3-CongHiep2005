{
  "info": {
    "_postman_id": "fit4110-lab03-iot-ingestion-02-auth",
    "name": "FIT4110 Lab03 - 02_Auth",
    "description": "Auth tests: valid token, missing token, invalid token",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET /readings/latest - valid token is accepted",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{authToken}}" } ],
        "url": {
          "raw": "{{baseUrl}}/readings/latest?limit=1",
          "protocol": "{{protocol}}",
          "host": ["{{host}}"],
          "port": "{{port}}",
          "path": ["readings","latest"],
          "query": [ { "key": "limit", "value": "1" } ]
        }
      },
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Valid token request returns success', function () {",
        "  pm.expect(pm.response.code).to.eql(200);",
        "});"
      ] } } ]
    },
    {
      "name": "POST /readings - missing token is rejected on real service",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/readings", "protocol": "{{protocol}}", "host": ["{{host}}"], "port": "{{port}}", "path": ["readings"] },
        "body": { "mode": "raw", "raw": "{\n  \"device_id\": \"ESP32-LAB-A01\",\n  \"metric\": \"temperature\",\n  \"value\": 31.5,\n  \"unit\": \"celsius\",\n  \"timestamp\": \"2026-05-13T08:30:00+07:00\"\n}", "options": { "raw": { "language": "json" } } },
        "description": "Auth test thật: service local phải tự từ chối token sai."
      },
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const env = pm.environment.get('env') || 'mock';",
        "if (env === 'mock') {",
        "  pm.test('Skipped on mock: Prism does not enforce real auth without a service implementation', function () { pm.expect(true).to.eql(true); });",
        "} else {",
        "  pm.test('Missing token returns 401 or 403', function () { pm.expect([401, 403]).to.include(pm.response.code); });",
        "}"
      ] } } ]
    },
    {
      "name": "POST /readings - invalid token is rejected on real service",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer invalid-token" } ],
        "url": { "raw": "{{baseUrl}}/readings", "protocol": "{{protocol}}", "host": ["{{host}}"], "port": "{{port}}", "path": ["readings"] },
        "body": { "mode": "raw", "raw": "{\n  \"device_id\": \"ESP32-LAB-A01\",\n  \"metric\": \"temperature\",\n  \"value\": 31.5,\n  \"unit\": \"celsius\",\n  \"timestamp\": \"2026-05-13T08:30:00+07:00\"\n}", "options": { "raw": { "language": "json" } } },
        "description": "Auth test for invalid token"
      },
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const env = pm.environment.get('env') || 'mock';",
        "if (env === 'mock') {",
        "  pm.test('Skipped on mock: invalid token requires real auth middleware', function () { pm.expect(true).to.eql(true); });",
        "} else {",
        "  pm.test('Invalid token returns 401 or 403', function () { pm.expect([401, 403]).to.include(pm.response.code); });",
        "}"
      ] } } ]
    }
  ]
}
