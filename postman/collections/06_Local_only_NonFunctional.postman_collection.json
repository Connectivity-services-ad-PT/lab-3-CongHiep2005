{
  "info": {
    "_postman_id": "fit4110-lab03-iot-ingestion-06-local-only",
    "name": "FIT4110 Lab03 - 06_Local_only_NonFunctional",
    "description": "Local-only non-functional checks (latency/SLA)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST /readings - local response time threshold",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{authToken}}" } ],
        "url": { "raw": "{{baseUrl}}/readings", "protocol": "{{protocol}}", "host": ["{{host}}"], "port": "{{port}}", "path": ["readings"] },
        "body": { "mode": "raw", "raw": "{\n  \"device_id\": \"ESP32-LAB-A02\",\n  \"metric\": \"humidity\",\n  \"value\": 55.2,\n  \"unit\": \"percent\",\n  \"timestamp\": \"2026-05-13T08:31:00+07:00\"\n}", "options": { "raw": { "language": "json" } } },
        "description": "Latency/SLA only meaningful on real local service"
      },
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const env = pm.environment.get('env') || 'mock';",
        "if (env === 'local') { pm.test('Local service responds under 1000ms', function () { pm.expect(pm.response.responseTime).to.be.below(1000); }); } else { pm.test('Skipped on mock: mock latency is not evidence of real service reliability', function () { pm.expect(true).to.eql(true); }); }"
      ] } } ]
    }
  ]
}
